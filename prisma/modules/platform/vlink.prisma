// ============================================================================
// V_LINK PLATFORM LAYER
// ============================================================================

enum VLinkScope {
  PERSONAL
  BUSINESS
  HOUSEHOLD
}

enum VLinkStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum VLinkMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum VLinkEntityType {
  FILE
  FOLDER
  CALENDAR_EVENT
  CHAT_CONVERSATION
  CHAT_THREAD
  TASK
  TODO
  NOTE
  DASHBOARD
  WIDGET
  USER
  BUSINESS
  HOUSEHOLD
  MODULE_ENTITY
}

enum VLinkEntityRelationType {
  PRIMARY
  REFERENCE
}

enum VLinkEntitySource {
  MANUAL
  AI_SUGGESTED
  SYSTEM
}

enum VLinkSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum VLinkSuggestionSource {
  AI
  SYSTEM
}

model VLink {
  id            String       @id @default(uuid())
  publicCode    String       @unique
  title         String
  description   String?
  scope         VLinkScope
  dashboardId   String
  businessId    String?
  householdId   String?
  ownerUserId   String
  owner         User         @relation("VLinkOwner", fields: [ownerUserId], references: [id])
  parentVLinkId String?
  parent        VLink?       @relation("VLinkNesting", fields: [parentVLinkId], references: [id], onDelete: SetNull)
  children      VLink[]      @relation("VLinkNesting")
  color         String?
  icon          String?
  status        VLinkStatus  @default(ACTIVE)
  metadata      Json?
  createdById   String
  createdBy     User         @relation("VLinkCreator", fields: [createdById], references: [id])
  updatedById   String?
  updatedBy     User?        @relation("VLinkUpdater", fields: [updatedById], references: [id])
  archivedAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  members       VLinkMember[]
  entities      VLinkEntity[]
  suggestions   VLinkSuggestion[]
  activities    VLinkActivity[]

  @@index([dashboardId, businessId, householdId])
  @@index([ownerUserId])
  @@index([parentVLinkId])
  @@index([status])
  @@index([publicCode])
  @@map("v_links")
}

model VLinkMember {
  id          String          @id @default(uuid())
  vlinkId     String
  vlink       VLink           @relation(fields: [vlinkId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation("VLinkMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role        VLinkMemberRole
  invitedById String?
  invitedBy   User?           @relation("VLinkMemberInviter", fields: [invitedById], references: [id])
  acceptedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([vlinkId, userId])
  @@index([userId])
  @@index([vlinkId])
  @@map("vlink_members")
}

model VLinkEntity {
  id           String                  @id @default(uuid())
  vlinkId      String
  vlink        VLink                   @relation(fields: [vlinkId], references: [id], onDelete: Cascade)
  entityType   VLinkEntityType
  entityId     String
  moduleId     String?
  relationType VLinkEntityRelationType @default(PRIMARY)
  isPrimary    Boolean                 @default(true)
  linkedById   String
  linkedBy     User                    @relation("VLinkEntityLinker", fields: [linkedById], references: [id])
  source       VLinkEntitySource       @default(MANUAL)
  metadata     Json?
  unlinkedAt   DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@unique([vlinkId, entityType, entityId])
  @@index([entityType, entityId])
  @@index([vlinkId])
  @@map("vlink_entities")
}

model VLinkSuggestion {
  id             String                 @id @default(uuid())
  vlinkId        String?
  vlink          VLink?                 @relation(fields: [vlinkId], references: [id], onDelete: SetNull)
  suggestedTitle String?
  entityType     VLinkEntityType
  entityId       String
  moduleId       String?
  suggestedBy    VLinkSuggestionSource
  confidence     Float?
  reasonCodes    Json?
  explanation    String?
  status         VLinkSuggestionStatus  @default(PENDING)
  reviewedById   String?
  reviewedBy     User?                  @relation("VLinkSuggestionReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  dashboardId    String?
  businessId     String?
  householdId    String?
  userId         String
  user           User                   @relation("VLinkSuggestionUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([userId, status])
  @@index([vlinkId])
  @@index([entityType, entityId])
  @@map("vlink_suggestions")
}

model VLinkActivity {
  id          String           @id @default(uuid())
  vlinkId     String
  vlink       VLink            @relation(fields: [vlinkId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?            @relation("VLinkActivityActor", fields: [actorUserId], references: [id])
  action      String
  entityType  VLinkEntityType?
  entityId    String?
  metadata    Json?
  createdAt   DateTime         @default(now())

  @@index([vlinkId, createdAt])
  @@map("vlink_activities")
}
