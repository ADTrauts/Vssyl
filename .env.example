# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema
#
# Copy to `.env` (repo root) for local development. Do not commit real secrets.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Database connection for Prisma CLI and global scripts
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/blockondrive"
# Backend API Configuration
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# JWT / NextAuth — required by the API server and NextAuth (generate with: openssl rand -base64 32)
JWT_SECRET=
JWT_REFRESH_SECRET=
NEXTAUTH_SECRET=

# Google Cloud Storage Configuration
STORAGE_PROVIDER=gcs
GOOGLE_CLOUD_PROJECT_ID=vssyl-472202
GOOGLE_CLOUD_STORAGE_BUCKET=vssyl-storage-472202

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=

# --- Partner Search Delegate (Phase 1B-B — default OFF) ---
# Enable sandbox pilot delegate in local/dev only.
PARTNER_SEARCH_DELEGATE_ENABLED=false
PARTNER_SEARCH_DELEGATE_MODULE_ALLOWLIST=vssyl-pilot-assets

# --- Partner Workspace Bridge (Phase 1B-C — default OFF) ---
PARTNER_WORKSPACE_BRIDGE_ENABLED=false
PARTNER_WORKSPACE_BRIDGE_MODULE_ALLOWLIST=vssyl-pilot-assets
# PARTNER_WORKSPACE_BRIDGE_JWT_TTL_SECONDS=120

PARTNER_ACTIVITY_INGEST_ENABLED=false
PARTNER_ACTIVITY_INGEST_MODULE_ALLOWLIST=vssyl-pilot-assets
# PARTNER_ACTIVITY_INGEST_JWT_TTL_SECONDS=90

# --- Context Graph: Project Assistant pilot (local/dev only — default OFF) ---
# Enable all three together to validate Search → Retrieval → Graph Bundle → Reconcile.
# Do NOT set these in production without Phase 1C validation sign-off.
# AI_RETRIEVAL_PROJECT_ASSISTANT_ENABLED=false
# CONTEXT_GRAPH_RETRIEVAL_BRIDGE_ENABLED=false
# CONTEXT_GRAPH_GROUNDING_RECONCILE_ENABLED=false
